# Copy to .env and fill in. Never commit .env.

# Database password (PostgreSQL + pgvector container).
DB_PASSWORD=

# Signs user access tokens. At least 32 bytes:  openssl rand -base64 48
JWT_SECRET=

# Shared secret between the API and the evidence service:  openssl rand -base64 32
AI_INTERNAL_TOKEN=

# Optional: enables Claude synthesis behind the verification gate.
# Without it, the extractive evidence engine answers on its own (and says so in the UI).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Optional
MAX_FILE_MB=25
DEMO_ENABLED=true
WEB_PORT=8080
